POSTGRES_DB=digital_fitness
POSTGRES_USER=fitness_app
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5433

DATABASE_URL=jdbc:postgresql://localhost:5433/digital_fitness
DATABASE_USERNAME=fitness_app
DATABASE_PASSWORD=change-me

REDIS_PORT=6379

MINIO_ROOT_USER=fitness_admin
MINIO_ROOT_PASSWORD=change-me-now
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

BACKEND_PORT=8080
JWT_ISSUER=fitness-coaching-backend
JWT_SECRET=replace-with-at-least-32-random-bytes
ACCESS_TOKEN_TTL=PT15M
REFRESH_TOKEN_TTL=P30D
AI_SERVICE_PORT=8000
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# Mailpit remains the default in dev. Real SMTP must be selected explicitly.
VERIFICATION_EMAIL_MODE=mailpit
# For real SMTP, uncomment and replace placeholders in ignored .env, then set mode=smtp.
# VERIFICATION_EMAIL_FROM=your-authorized-sender@example.com
# SPRING_MAIL_HOST=smtp.your-provider.example
# SPRING_MAIL_PORT=587
# SPRING_MAIL_USERNAME=your-smtp-username
# SPRING_MAIL_PASSWORD=replace-locally-never-commit
# SMTP_AUTH=true
# SMTP_STARTTLS=true
# SMTP_SSL=false
# SMTP_CONNECTION_TIMEOUT_MS=5000
# SMTP_READ_TIMEOUT_MS=5000
# SMTP_WRITE_TIMEOUT_MS=5000
